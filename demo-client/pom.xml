<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>de.cuioss.sheriff.gateway</groupId>
        <artifactId>api-sheriff-parent</artifactId>
        <version>0.2.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>demo-client</artifactId>
    <packaging>pom</packaging>
    <name>API Sheriff Demo Client</name>
    <description>Dependency-free demo SPA for the API Sheriff BFF plus the Playwright end-to-end suite that
        drives it against the integration-tests stack. Demo and compose material only — never a shipped
        default, never part of the production image or the native build.
    </description>

    <!-- This module carries NO Java. It exists to own the demo SPA sources, the Playwright suite and the
         npm toolchain that runs them. Everything npm-related lives inside the 'e2e-demo' profile below,
         so a default reactor build of this module is a genuine no-op: no Node download, no npm install,
         no container, no artifact. See doc/playwright-suite.adoc for the full rationale. -->

    <dependencies />

    <properties>
        <!-- ==== Java plugin suppression =================================================== -->
        <!-- There is no Java here, so every inherited Java-oriented plugin is switched off. Without
             these the module would still run compilation, javadoc, static analysis and coverage over
             an empty source tree, costing time in every build for no signal. -->
        <maven.compiler.skip>true</maven.compiler.skip>
        <skipTests>true</skipTests>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.install.skip>true</maven.install.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
        <checkstyle.skip>true</checkstyle.skip>
        <spotbugs.skip>true</spotbugs.skip>
        <pmd.skip>true</pmd.skip>
        <cpd.skip>true</cpd.skip>
        <enforcer.skip>true</enforcer.skip>
        <jacoco.skip>true</jacoco.skip>
        <license.skip>true</license.skip>
        <dependency-check.skip>true</dependency-check.skip>
        <skip.openrewrite>true</skip.openrewrite>

        <!-- Never publish this module to Maven Central: it is demo material, not a consumable
             artifact. The effective switch is skipPublishing, NOT maven.deploy.skip — cui-java-parent
             publishes through central-publishing-maven-plugin, whose own user property this is. The
             same reasoning is recorded at integration-tests/pom.xml, where it was established. -->
        <skipPublishing>true</skipPublishing>

        <!-- ==== Node toolchain ============================================================ -->
        <!-- Pinned so every developer and CI run uses one toolchain. frontend-maven-plugin
             downloads it into target/ (installDirectory below), which the root .gitignore already
             covers through its **/target pattern — no new ignore rule is needed for the toolchain. -->
        <node.version>v22.14.0</node.version>
        <npm.version>10.9.2</npm.version>
        <version.frontend-maven-plugin>2.0.2</version.frontend-maven-plugin>

        <!-- ==== The opt-in switch ========================================================= -->
        <!-- Defaults to SKIP. Every execution in the e2e-demo profile carries this as its <skip>,
             and the profile itself flips it to false. Two layers on purpose: the profile means a
             default build has no executions to skip at all, and the property means an accidentally
             activated profile still needs a deliberate override to run browsers. -->
        <skipPlaywrightTests>true</skipPlaywrightTests>

        <!-- ==== Stack coordinates ========================================================= -->
        <!-- The published ports of the two demo gateway instances and of Keycloak, passed to the
             suite as environment. Declared here so NO port number is restated inside JavaScript. -->
        <demo.baseUrl.server>https://localhost:10443</demo.baseUrl.server>
        <demo.baseUrl.cookie>https://localhost:10445</demo.baseUrl.cookie>
        <demo.keycloak.url>https://localhost:1443</demo.keycloak.url>
    </properties>

    <profiles>
        <!-- The ONLY place npm is touched. Activated explicitly with -Pe2e-demo; the standard
             pull-request build and 'verify -Ppre-commit' never enter it, so neither downloads Node
             nor starts a container. -->
        <profile>
            <id>e2e-demo</id>
            <properties>
                <skipPlaywrightTests>false</skipPlaywrightTests>
                <!-- LOAD-BEARING. The module-level <skipTests>true</skipTests> above exists to keep
                     inherited Java surefire off a module with no Java — but frontend-maven-plugin's
                     'playwright-test' execution is bound to integration-test, a TESTING phase, so it
                     honours skipTests too and logs "Skipping execution.". The profile would then
                     report BUILD SUCCESS having run ZERO specs — a vacuous green that also made the
                     demo-client-e2e CI job meaningless. Flipping it back inside this opt-in profile
                     costs nothing (surefire is a no-op with no test sources) and is deliberately
                     scoped here so a DEFAULT reactor build of this module stays a genuine no-op. -->
                <skipTests>false</skipTests>
            </properties>
            <build>
                <plugins>
                    <!-- Tear down anything an aborted previous run left behind, before clean. -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>stop-dev-environment-pre-clean</id>
                                <phase>pre-clean</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <skip>${skipPlaywrightTests}</skip>
                                    <executable>./scripts/stop-dev-environment.sh</executable>
                                    <workingDirectory>${project.basedir}</workingDirectory>
                                    <!-- Nothing running is the normal case, not a failure. -->
                                    <successCodes>
                                        <successCode>0</successCode>
                                        <successCode>1</successCode>
                                    </successCodes>
                                </configuration>
                            </execution>
                            <execution>
                                <id>start-dev-environment</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <skip>${skipPlaywrightTests}</skip>
                                    <executable>./scripts/start-dev-environment.sh</executable>
                                    <workingDirectory>${project.basedir}</workingDirectory>
                                </configuration>
                            </execution>
                            <!-- The SUCCESS-path teardown, and deliberately only that. Maven offers
                                 no always-runs hook, and frontend-maven-plugin's npm goal aborts the
                                 build on a non-zero exit, so a FAILING suite never reaches this
                                 phase. Two paths, two remedies, decided explicitly:
                                   - CI: .github/workflows/demo-client-e2e.yml carries an
                                     `if: always()` teardown step, because an abandoned stack on a
                                     shared runner holds the fixed host ports.
                                   - LOCAL: no equivalent is added. The developer already has two
                                     direct remedies — `./scripts/stop-dev-environment.sh`, and the
                                     pre-clean teardown above that fires on any `clean` build — and
                                     the failing run they are about to debug is usually one they WANT
                                     the containers left up for. Making the local path tear down
                                     unconditionally would destroy the logs of the failure being
                                     diagnosed. This is a decision, not an omission; it is documented
                                     for developers in doc/playwright-suite.adoc. -->
                            <execution>
                                <id>stop-dev-environment-post-integration-test</id>
                                <phase>post-integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <skip>${skipPlaywrightTests}</skip>
                                    <executable>./scripts/stop-dev-environment.sh</executable>
                                    <workingDirectory>${project.basedir}</workingDirectory>
                                    <successCodes>
                                        <successCode>0</successCode>
                                        <successCode>1</successCode>
                                    </successCodes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>com.github.eirslett</groupId>
                        <artifactId>frontend-maven-plugin</artifactId>
                        <version>${version.frontend-maven-plugin}</version>
                        <configuration>
                            <!-- Keep the downloaded toolchain under target/ so it is already
                                 git-ignored and is removed by 'mvn clean'. -->
                            <installDirectory>${project.build.directory}</installDirectory>
                            <skip>${skipPlaywrightTests}</skip>
                        </configuration>
                        <executions>
                            <execution>
                                <id>install-node-and-npm</id>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>install-node-and-npm</goal>
                                </goals>
                                <configuration>
                                    <nodeVersion>${node.version}</nodeVersion>
                                    <npmVersion>${npm.version}</npmVersion>
                                </configuration>
                            </execution>
                            <execution>
                                <id>npm-install</id>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>npm</goal>
                                </goals>
                                <configuration>
                                    <!-- 'ci', NOT 'install'. package-lock.json is committed with a
                                         'resolved' + 'integrity' entry for all 80 packages, and only
                                         'npm ci' treats it as authoritative: it installs exactly the
                                         locked tree and FAILS when the lock and package.json have
                                         drifted apart. 'npm install' is permitted to re-resolve within
                                         the manifest's caret ranges and to silently rewrite the lock,
                                         which would let an unreviewed transitive version enter a build
                                         that still looks reproducible. Fail-closed lock-file discipline
                                         is the point; the from-scratch reinstall it implies costs
                                         seconds in an opt-in profile. -->
                                    <arguments>ci</arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>npm-lint-strict</id>
                                <!-- process-resources, NOT verify. verify runs AFTER
                                     integration-test, so binding the lint there made a lint failure
                                     surface only once a native image had been rebuilt, three
                                     containers were up and a browser had driven both projects.
                                     process-resources is the earliest phase that still follows the
                                     'initialize' npm install, so the lint now fails before
                                     start-dev-environment.sh runs — which also means a lint failure
                                     can no longer leak containers. -->
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>npm</goal>
                                </goals>
                                <configuration>
                                    <arguments>run lint:strict</arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>npm-install-browser</id>
                                <!-- Same phase as the lint and declared after it, so executions run
                                     in this order: a lint failure costs no browser download.

                                     WHY THIS EXISTS AT ALL: nothing previously installed a browser.
                                     The local run only worked because the 'playwright' package's npm
                                     postinstall happens to download one, and 'npm ci' runs
                                     postinstall scripts. Relying on that is a silent dependency on
                                     another package's install hook. .github/workflows/demo-client-e2e.yml
                                     has never executed — it carries no pull_request trigger — so its
                                     first ever run is on a fresh runner, and this makes the browser a
                                     declared, verified step there instead of a hoped-for side effect.
                                     'playwright install' is idempotent: with a warm cache it is a
                                     no-op costing under a second.

                                     WHY THE PLAIN INSTALL AND NOT THE 'with deps' VARIANT: that
                                     variant installs OS packages and needs root. This execution is on
                                     the LOCAL developer's 'verify -Pe2e-demo' path too, where sudo is
                                     not available and must not be required. The GitHub-hosted
                                     ubuntu-latest image already carries the shared libraries Chromium
                                     needs, so one root-free placement serves both paths rather than
                                     splitting into a CI-only variant.

                                     WHY 'npm run', not npx: identical to the playwright-test execution
                                     below — 'npm run' resolves node_modules/.bin only and has no
                                     registry fallback. -->
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>npm</goal>
                                </goals>
                                <configuration>
                                    <arguments>run install-browser</arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>playwright-test</id>
                                <phase>integration-test</phase>
                                <goals>
                                    <goal>npm</goal>
                                </goals>
                                <configuration>
                                    <!-- 'npm run test' (the package.json script, which is
                                         'playwright test'), NOT npx with its auto-confirm flag. npx
                                         resolves the binary from node_modules/.bin when present, but
                                         auto-confirm suppresses the prompt guarding npx's fallback
                                         path — so if the locked install ever failed to place the
                                         binary, npx would silently FETCH AND EXECUTE an unpinned
                                         'playwright' package straight from the registry, outside the
                                         integrity-pinned lock file the step above just enforced. That
                                         is remote code execution from an unreviewed source inside the
                                         build. 'npm run' only ever resolves node_modules/.bin and has
                                         no registry fallback: a missing binary is a hard failure
                                         instead of a silent download. -->
                                    <arguments>run test</arguments>
                                    <environmentVariables>
                                        <PLAYWRIGHT_BASE_URL_SERVER>${demo.baseUrl.server}</PLAYWRIGHT_BASE_URL_SERVER>
                                        <PLAYWRIGHT_BASE_URL_COOKIE>${demo.baseUrl.cookie}</PLAYWRIGHT_BASE_URL_COOKIE>
                                        <KEYCLOAK_HOST_URL>${demo.keycloak.url}</KEYCLOAK_HOST_URL>
                                        <!-- Never spawn a report server: a blocked run in CI is
                                             indistinguishable from a hang. -->
                                        <PW_TEST_HTML_REPORT_OPEN>never</PW_TEST_HTML_REPORT_OPEN>
                                    </environmentVariables>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>

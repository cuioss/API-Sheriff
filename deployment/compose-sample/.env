# Compose auto-loads this file from the project directory, so it is the SINGLE place the sample's
# gateway image default is written. docker-compose.yml references ${API_SHERIFF_IMAGE} with no
# inline fallback, and start-sample.sh reads the value back out of the resolved Compose model
# rather than restating it -- the same derive-don't-restate rule start-sample.sh's own step 2 follows
# for the readiness probe, deriving its targets from the de.cuioss.sheriff.management-scheme and
# de.cuioss.sheriff.management-root-path labels in the resolved Compose model (ADR-0031).
#
# An exported API_SHERIFF_IMAGE in the environment WINS over this file, which is how the
# local-build override documented in doc/user/compose-sample.adoc works:
#
#   API_SHERIFF_IMAGE=api-sheriff:distroless ./scripts/start-sample.sh
#
# Keep this pin on the current release. The release runbook
# (.claude/skills/release/SKILL.md, Step 10) updates it as part of cutting a version, so that a
# freshly cloned sample always pulls an image that exists.
API_SHERIFF_IMAGE=ghcr.io/cuioss/api-sheriff:0.2.1
